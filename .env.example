# ==========================================
# 1. KONFIGURASI API & GAMBAR BACKEND
# ==========================================
NEXT_PUBLIC_API_BASE_URL=https://example.com/api
NEXT_PUBLIC_IMAGE_BASE_URL=https://example.com

# Target rewrite /api-proxy/:path* (server-side, tidak dikirim ke browser).
# Opsional; harus berakhir tanpa "/" dan sudah menyertakan prefix "/api".
API_PROXY_TARGET=https://example.com/api

# Opsional (development): hostname tambahan yang boleh mengakses dev server.
# Pisahkan dengan koma, tanpa protokol/port. Contoh: 192.168.1.10,dev.example.com
DEV_ALLOWED_ORIGINS=

# ==========================================
# 2. KONFIGURASI FIREBASE (Untuk Login Google)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==========================================
# 3. QRIS DINAMIS (FALLBACK PAYMENT GATEWAY)
# ==========================================
# Payload EMVCo QRIS statis milik yayasan (diawali "000201010211...").
# Dipakai generateDynamicQris() untuk menyematkan nominal donasi/wakaf.
NEXT_PUBLIC_QRIS_STATIS=

# ==========================================
# 4. KONFIGURASI BLOCKCHAIN (Polygon/Ethers.js)
# ==========================================
# Jika Anda menggunakan smart contract, letakkan di sini (bisa diisi nanti jika belum ada)
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_RPC_URL=